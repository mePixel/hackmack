---
import { event } from '../../config/event';
const visibility: Record<string, boolean> = { '/#location': event.enabled.venue, '/#why': event.enabled.why, '/#pricing': event.enabled.schedule, '/#delegation': event.enabled.tracks, '/#how-it-works': event.enabled.steps, '/#faq': event.enabled.faq };
const columns = event.footerColumns.map(column => ({ ...column, links: column.links.filter(link => visibility[link.href] !== false) })).filter(column => column.links.length);
---
<footer class="footer" id="footer">
  <div class="footer__inner">
    <div class="footer__top">
      <!-- shortcut: the pixel wordmark uses the current name and accent; redraw it when either changes. -->
      <a href="/" class="footer__wordmark"><img src="/assets/hackathon-wordmark.png" width="440" height="21" alt={event.name} loading="lazy" /></a>
    </div>

    <div class="footer__mid">
      <p class="footer__tagline">{event.enabled.venue ? event.footerTagline : <>{event.duration} of building together.<br />Venue to be confirmed.</>}<br />{event.date}.</p>
      <nav class="footer__cols" aria-label="Footer">
        {columns.map((col) => (
          <div class="footer__col">
            <p class="footer__col-title">{col.title}</p>
            {col.links.map((l) => <a href={l.href}>{l.label}</a>)}
          </div>
        ))}
      </nav>
    </div>

    <div class="footer__bottom">
      <p>© 2026 Hackmack.</p>
      <a href="/imprint/">Imprint</a>
    </div>
  </div>
</footer>
