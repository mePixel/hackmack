---
import Button from '../Button.astro';
import { event } from '../../config/event';
---
<section class="cta" id="cta">
  <div class="cta__panel">
    <img class="cta__bg" src="/assets/cta-mountains.webp" alt="" loading="lazy" />
    <div class="cta__overlay"></div>
    <div class="cta__content">
      <h2 class="cta__title">{event.closing.title}</h2>
      <p class="cta__lede">{event.registration.url ? event.closing.description : event.registration.description}</p>
      {event.registration.url ? <Button href={event.registration.url} label={event.registration.label} variant="primary" /> : <p class="cta__lede">{event.registration.pending}</p>}
      {event.contactEmail && <Button href={`mailto:${event.contactEmail}`} label="Contact the organizers" variant="primary" />}
    </div>
  </div>
</section>
