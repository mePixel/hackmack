---
import { event } from '../../config/event';
/** The pricing page promotes this heading to the page h1. */
const { headingLevel = 2, display = false } = Astro.props;
const Heading = headingLevel === 1 ? 'h1' : 'h2';
---
<section class="pricing" id="pricing">
  <header class="pricing__header">
    <div class="pricing__heading">
      <Heading class={display ? 'ts-display' : 'h2'}>
        {event.sections.schedule.title}
      </Heading>
    </div>
    <div class="pricing__side">
      <p class="pricing__lede">{event.sections.schedule.description}</p>
    </div>
  </header>

  <div class="plans" id="plans">
    {event.schedule.map((day, i) => (
      <article class={`plan${i === 1 ? ' is-featured' : ''}`} data-index={i}>
        <h4 class="plan__name">{day.day}</h4>
        <div class="plan__pricing"><h3 class="plan__price event-day">{day.date}</h3><p class="plan__period">{event.enabled.venue ? event.location : 'Venue to be confirmed'}</p></div>
        <ul class="plan-features">{day.items.map(item => <li><span class="plan-features__dot"></span><span><strong>{item.time}</strong> · {item.title}</span></li>)}</ul>
      </article>
    ))}
  </div>
</section>
