---
import Button from '../Button.astro';
import { event } from '../../config/event';
---
<section class="hero" id="hero">
  <div class="hero__panel" id="hero-media">
    <img class="hero__img" src={event.heroImage} alt="" />
    <div class="hero__overlay"></div>
    <div class="hero__content">
      <h1 class="hero__headline">
        {event.name}
      </h1>
      <p class="hero__lede"><span class="hero__date">{event.date}</span>{event.enabled.venue ? event.location : 'Venue to be confirmed'}<br />{event.cost}</p>
      <Button href={event.registration.url || "#cta"} label={event.registration.url ? event.registration.label : event.registration.navLabel} variant="primary" class="hero__join" />
    </div>
  </div>
</section>
