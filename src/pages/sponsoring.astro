---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import { event } from '../config/event';
---
<Base title={`Sponsoring | ${event.name}`} description={`Support ${event.name}${event.enabled.venue ? ` at ${event.venue}` : ""}. Get in touch to discuss sponsoring the hackathon.`} path="/sponsoring/" cta={false} schema={false}>
  <article class="legal sponsoring">
    <h1 class="legal__title">Support {event.name}.</h1>
    <p class="legal__intro">Interested in sponsoring the hackathon? Here’s how to get involved.</p>

    <section class="legal__body">
      <h2 class="legal__h">About the event</h2>
      <p>{event.name} is a 24-hour hackathon{event.enabled.venue && <> at {event.venue}</>} on {event.date}. {!event.enabled.venue && <>Venue to be confirmed. </>} Participants work in teams and present their projects on Sunday. Taking part is free.</p>
    </section>

    <section class="legal__body">
      <h2 class="legal__h">Ways to get involved</h2>
      <p>You could help with funding, food and drinks, equipment, or mentoring. Contact us to discuss what you have in mind.</p>
    </section>

    <section class="legal__body" aria-labelledby="sponsoring-contact">
      <h2 class="legal__h" id="sponsoring-contact">Contact</h2>
      {event.contactEmail ? <>
        <p>Contact the {event.name} organizers at <a href={`mailto:${event.contactEmail}`}>{event.contactEmail}</a>. Tell us a little about your organization and how you’d like to contribute.</p>
        <Button href={`mailto:${event.contactEmail}?subject=${encodeURIComponent(`${event.name} sponsoring`)}`} label="Get in touch" variant="primary" />
      </> : <p>Sponsoring contact details will be announced soon.</p>}
    </section>
  </article>
</Base>

<style>
  .sponsoring .legal__body { margin-top: 40px; align-items: start; }
  .sponsoring p { line-height: 1.65; }
  .sponsoring p a { color: var(--brand-500); text-decoration: underline; text-underline-offset: 0.15em; overflow-wrap: anywhere; }
</style>
