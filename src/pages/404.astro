---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import { event } from '../config/event';
---
<Base title={`Page not found | ${event.name}`} description="The requested page could not be found." path="/404" cta={false} schema={false}>
  <section class="nf"><img class="nf__mosaic" src="/assets/404-mosaic.png" alt="" /><p class="nf__code" aria-hidden="true">404</p><h1 class="nf__title">Oops! The page you’re looking for can’t be found.</h1><Button href="/" label="Go to Home page" variant="primary" /></section>
</Base>
