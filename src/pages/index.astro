---
import Base from '../layouts/Base.astro';
import Hero from '../components/sections/Hero.astro';
import Logos from '../components/sections/Logos.astro';
import Why from '../components/sections/Why.astro';
import Delegation from '../components/sections/Delegation.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import Pricing from '../components/sections/Pricing.astro';
import HowItWorks from '../components/sections/HowItWorks.astro';
import Faq from '../components/sections/Faq.astro';
import Integrations from '../components/sections/Integrations.astro';
import Location from '../components/sections/Location.astro';
import { event } from '../config/event';
---
<Base title={`${event.name} ${event.edition} — ${event.duration} hackathon · ${event.enabled.venue ? event.location : 'Venue to be confirmed'}`} description={event.description} path="/" schema={false}>
  <Hero />
  {event.enabled.logos && <Logos />}
  <section class="about" aria-labelledby="about-title">
    <h2 class="h2" id="about-title">{event.about.title}</h2>
    <p>{event.about.description}</p>
    <ul class="about__highlights">
      {event.about.highlights.map(highlight => <li>{highlight}</li>)}
    </ul>
  </section>
  {event.enabled.why && <Why />}
  {event.enabled.tracks && <Delegation />}
  {event.enabled.people && <Testimonials />}
  {event.enabled.schedule && <Pricing />}
  {event.enabled.steps && <HowItWorks />}
  {event.enabled.venue && <Location />}
  {event.enabled.faq && <Faq />}
  {event.enabled.tools && <Integrations />}
</Base>

<style>
  .about { padding: 40px 0; display: flex; flex-direction: column; gap: 20px; }
  .about p { margin: 0; max-width: 70ch; color: #000; font-size: 18px; line-height: 1.6; }
  .about__highlights { display: flex; flex-wrap: wrap; gap: 24px; margin: 0; padding: 0; list-style: none; }
  .about__highlights li { padding: 24px 32px; border-radius: 12px; background: var(--footer); color: var(--brand-500); font-size: 24px; font-weight: 600; }
</style>
